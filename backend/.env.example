# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/swcm_db

# Or use individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swcm_db
DB_USER=postgres
DB_PASSWORD=password

# Server
PORT=3001
WS_PORT=3002

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Simulator tick interval in ms (default: 4000)
SIMULATOR_INTERVAL_MS=4000
